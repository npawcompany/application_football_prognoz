FOOTBALL_DATA_API_KEY=
# Ollama Cloud (https://ollama.com/settings/keys). Без ключа AI-разбор выключен,
# числа 1X2 всё равно считаются локально. Для локального Ollama ключ не нужен,
# достаточно OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash
OLLAMA_FALLBACK_MODEL=gpt-oss:120b
# API-Football v3 (dashboard.api-football.com): травмы, дисквалификации, красные
# карточки, составы. Пусто = блок «Состав и доступность» выключен, 0 запросов.
API_FOOTBALL_KEY=
DATABASE_PATH=data/cache/prognoz.db
# Любимые лиги, коды через запятую: PL,PD,SA
FAVORITE_LEAGUES=
# Любимые команды, id football-data.org через запятую (выбор в Настройках)
FAVORITE_TEAMS=
# Системные уведомления ОС (macOS/Linux). Первый показ может запросить разрешение.
SYSTEM_NOTIFICATIONS=false
# Ждать обновление всех лиг при старте
PREFETCH_WAIT_ON_START=false
# Показывать AI-пояснение
SHOW_AI_BLOCK=true
# Компактный календарь
COMPACT_FIXTURES=false
